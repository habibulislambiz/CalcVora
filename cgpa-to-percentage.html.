<!-- ===== JAVASCRIPT (Mobile Menu + CGPA Logic) ===== -->
<script>
  // 1. Mobile Menu Toggle
  const menuBtn = document.getElementById('menuToggle');
  const navMenu = document.querySelector('header nav');
  
  if (menuBtn && navMenu) {
    menuBtn.addEventListener('click', () => {
      const isHidden = navMenu.classList.contains('hidden');
      if (isHidden) {
        navMenu.classList.remove('hidden');
        navMenu.classList.add('flex', 'flex-col', 'absolute', 'top-16', 'left-0', 'w-full', 'bg-white', 'p-5', 'border-b', 'border-slate-200', 'shadow-lg', 'gap-4');
        menuBtn.textContent = '✕';
      } else {
        navMenu.classList.add('hidden');
        navMenu.classList.remove('flex', 'flex-col', 'absolute', 'top-16', 'left-0', 'w-full', 'bg-white', 'p-5', 'border-b', 'border-slate-200', 'shadow-lg', 'gap-4');
        menuBtn.textContent = '☰';
      }
    });
  }

  // 2. CGPA to Percentage Calculator Logic
  function convertCGPA() {
    const input = document.getElementById('cgpaInput');
    const select = document.getElementById('uniSelect');
    const resultBox = document.getElementById('resultBox');
    const resultValue = document.getElementById('resultValue');
    const resultFormula = document.getElementById('resultFormula');

    const cgpa = parseFloat(input.value);

    // Validation
    if (isNaN(cgpa)) {
      resultBox.classList.remove('hidden');
      resultValue.textContent = '—';
      resultFormula.textContent = 'Please enter a valid CGPA.';
      return;
    }
    if (cgpa < 0 || cgpa > 10) {
      resultBox.classList.remove('hidden');
      resultValue.textContent = '—';
      resultFormula.textContent = 'CGPA must be between 0 and 10.';
      return;
    }

    const uni = select.value;
    let percentage = 0;
    let formulaText = '';

    switch (uni) {
      case 'cbse':
        percentage = cgpa * 9.5;
        formulaText = `CGPA × 9.5 = ${percentage.toFixed(2)}%`;
        break;
      case 'vtu_old':
        percentage = (cgpa - 0.75) * 10;
        formulaText = `(CGPA − 0.75) × 10 = ${percentage.toFixed(2)}%`;
        break;
      case 'vtu_new':
        percentage = cgpa * 10;
        formulaText = `CGPA × 10 = ${percentage.toFixed(2)}%`;
        break;
      case 'anna':
        percentage = cgpa * 10;
        formulaText = `CGPA × 10 = ${percentage.toFixed(2)}%`;
        break;
      case 'mumbai_eng':
        percentage = (7.1 * cgpa) + 11;
        formulaText = `(7.1 × CGPI) + 11 = ${percentage.toFixed(2)}%`;
        break;
      case 'mumbai_other':
        percentage = (cgpa - 0.75) * 10;
        formulaText = `(CGPI − 0.75) × 10 = ${percentage.toFixed(2)}%`;
        break;
      case 'aktu':
        percentage = (cgpa * 10) - 7.5;
        formulaText = `CGPA × 10 − 7.5 = ${percentage.toFixed(2)}%`;
        break;
      case 'gtu':
        percentage = (cgpa - 0.5) * 10;
        formulaText = `(CGPA − 0.5) × 10 = ${percentage.toFixed(2)}%`;
        break;
      default:
        percentage = cgpa * 9.5;
        formulaText = `CGPA × 9.5 = ${percentage.toFixed(2)}%`;
    }

    // Clamp to 0–100
    if (percentage < 0) percentage = 0;
    if (percentage > 100) percentage = 100;

    resultBox.classList.remove('hidden');
    resultValue.textContent = percentage.toFixed(2) + '%';
    resultFormula.textContent = formulaText;
  }

  // 3. Allow "Enter" key to trigger calculation
  document.getElementById('cgpaInput').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') convertCGPA();
  });
</script>

